# .env.example

# Telegram bot token (do NOT store this in public places)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# A secret token appended to the webhook URL for basic verification
WEBHOOK_SECRET=some-random-string

# Comma separated admin Telegram IDs (e.g. 123456789,987654321)
ADMIN_IDS=123456789

# Public URL of your Render service (used when calling setWebhook)
APP_URL=https://your-render-url.onrender.com

# PORT is optional; Render will provide one
PORT=3000
